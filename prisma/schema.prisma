generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int      @id @default(autoincrement())
  username    String   @db.VarChar
  hashPwd     String   @map("hash_pwd") @db.VarChar
  title       String   @db.VarChar
  role        Int      @default(0) @db.SmallInt // 0=user, 1=admin
  status      Int      @default(0) @db.SmallInt // -1=suspend, 0=unauth, 1=active
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("update_at") @db.Timestamp(6)
  email       String   @unique @db.VarChar
  personnelId Int      @unique @map("personel_id")

  // Relations
  personnel       Personnel @relation(fields: [personnelId], references: [id])
  authorizedForms MrForm[]  @relation("MrFormAuthorizer")
  createdForms    MrForm[]  @relation("MrFormCreator")

  @@map("users")
}

model Personnel {
  id       Int    @id @default(autoincrement())
  fullname String @db.VarChar
  position String @db.VarChar

  // Relations
  user       User?
  ownedForms MrForm[]

  @@map("porsonel")
}

model MaterialType {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  materials Material[]

  @@map("material_type")
}

model Material {
  id             Int       @id @default(autoincrement())
  title          String    @db.VarChar
  materialTypeId Int       @map("material_type_id")
  quantity       Int       @default(0)
  unit           String    @db.VarChar
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  type        MaterialType      @relation(fields: [materialTypeId], references: [id])
  formLinks   MrFormMaterials[]

  @@map("material")
}

model MrForm {
  id             Int      @id @default(autoincrement())
  descripts      String?  @db.VarChar
  authorizerId   Int      @map("authorizer_id")
  materialsCount Int?     @map("materials") // Mapped to distinguish from the relation below
  creatorId      Int      @map("creator_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("update_at") @db.Timestamp(6)
  date           DateTime @db.Timestamp(6)
  subject        String   @db.VarChar
  refNo          String   @map("ref_no") @db.VarChar
  ownerId        Int      @map("owner")
  owingTo        String?  @map("owing_to") @db.VarChar

  // Relations
  authorizer User              @relation("MrFormAuthorizer", fields: [authorizerId], references: [id])
  creator    User              @relation("MrFormCreator", fields: [creatorId], references: [id])
  owner      Personnel         @relation(fields: [ownerId], references: [id])
  materials  MrFormMaterials[]

  @@map("mr_form")
}

model MrFormMaterials {
  id         Int @id @default(autoincrement())
  mrFormId   Int @map("mr_form_id")
  materialId Int @map("material_id")
  quantity   Int

  // Relations
  mrForm   MrForm   @relation(fields: [mrFormId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  @@map("mr_form_materials")
}