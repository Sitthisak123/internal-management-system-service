generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model material {
  id                Int                 @id @default(autoincrement())
  title             String
  material_type_id  Int
  unit              String
  minimum_threshold Int?
  quantity          Int                 @default(0)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  material_type     material_type       @relation(fields: [material_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mr_form_materials mr_form_materials[]

  @@index([material_type_id], map: "idx_material_material_type_id")
}

model material_type {
  id         Int        @id @default(autoincrement())
  title      String
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @default(now()) @db.Timestamptz(6)
  material   material[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model mr_form {
  id                                 Int                 @id @default(autoincrement())
  ref_no                             String              @unique
  subject                            String
  description                        String?
  purpose                            String?
  /// -1=Rejected, 0=Pending, 1=Approved
  status                             Int                 @default(0) @db.SmallInt
  form_date                          DateTime            @default(now()) @db.Timestamptz(6)
  created_at                         DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                         DateTime            @default(now()) @db.Timestamptz(6)
  creator_id                         Int
  owner_id                           Int
  authorizer_id                      Int?
  users_mr_form_authorizer_idTousers users?              @relation("mr_form_authorizer_idTousers", fields: [authorizer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_mr_form_creator_idTousers    users               @relation("mr_form_creator_idTousers", fields: [creator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  personnel                          users               @relation(fields: [owner_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  mr_form_materials                  mr_form_materials[]

  @@index([authorizer_id], map: "idx_mr_form_authorizer_id")
  @@index([creator_id], map: "idx_mr_form_creator_id")
  @@index([owner_id], map: "idx_mr_form_owner_id")
  @@index([status], map: "idx_mr_form_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model mr_form_materials {
  id          Int      @id @default(autoincrement())
  mr_form_id  Int
  material_id Int
  quantity    Int
  material    material @relation(fields: [material_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  mr_form     mr_form  @relation(fields: [mr_form_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([mr_form_id, material_id])
  @@index([mr_form_id], map: "idx_mrfm_form_id")
  @@index([material_id], map: "idx_mrfm_material_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                                   Int        @id @default(autoincrement())
  username                             String?    @unique
  hash_pwd                             String?
  display_name                         String?
  fullname                             String     @unique
  position                             String
  email                                String?    @unique
  role                                 Int        @default(0) @db.SmallInt
  status                               Int        @default(0) @db.SmallInt
  created_by                           Int?
  created_at                           DateTime   @default(now()) @db.Timestamptz(6)
  updated_at                           DateTime   @default(now()) @db.Timestamptz(6)
  del_logs                             del_logs[]
  mr_form_mr_form_authorizer_idTousers mr_form[]  @relation("mr_form_authorizer_idTousers")
  mr_form_mr_form_creator_idTousers    mr_form[]  @relation("mr_form_creator_idTousers")
  mr_form                              mr_form[]
  created_by_user                      users?     @relation("users_created_by", fields: [created_by], references: [id], onUpdate: NoAction)
  users_created_by                     users[]    @relation("users_created_by")

  @@index([created_by], map: "idx_users_created_by")
}

model del_logs {
  id             BigInt     @id @default(autoincrement())
  table_name     String
  record         Json
  deleted_by     Int?
  note           String?
  effected_by    BigInt?
  created_at     DateTime   @default(now()) @db.Timestamptz(6)
  users          users?     @relation(fields: [deleted_by], references: [id], onUpdate: NoAction)
  del_logs       del_logs?  @relation("del_logsTodel_logs", fields: [effected_by], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_del_logs del_logs[] @relation("del_logsTodel_logs")

  @@index([effected_by], map: "idx_del_logs_effected_by")
  @@index([table_name], map: "idx_del_logs_table_name")
}
