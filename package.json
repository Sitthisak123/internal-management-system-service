{
  "name": "express",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test": "tsx watch src/index.ts",
    "addadmin": "tsx .notes/create-admin.ts",
    "DBaddtables": "npx prisma db execute --file \".notes\\pg\\db-v4_pg-only_tables.sql\"",
    "DBaddmockupdata": "npx prisma db execute --file \".notes\\pg\\mockupdata-v4.sql\"",
    "DBreset": "npx prisma migrate reset --force && npm run DBaddtables && npm run DBaddmockupdata && npx prisma db pull && npx prisma generate && npm run addadmin && npm run dev"
  },
  "dependencies": {
    "@apollo/server": "^5.4.0",
    "@prisma/adapter-pg": "7.0.0",
    "@prisma/client": "^7.3.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "class-validator": "^0.15.1",
    "cors": "^2.8.6",
    "express": "5.1.0",
    "graphql": "^16.13.0",
    "graphql-scalars": "^1.25.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.17.2",
    "reflect-metadata": "^0.2.2",
    "type-graphql": "^2.0.0-rc.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.18.12",
    "@types/pg": "^8.16.0",
    "dotenv": "^17.2.1",
    "prisma": "^7.3.0",
    "tsx": "^4.20.6",
    "typescript": "5.8.2"
  }
}
